{
  "name": "kamehouse-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.4.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter kamehouse-web dev",
    "dev:desktop": "concurrently -k -n web,app -c cyan,green \"pnpm dev:web\" \"pnpm --filter kamehouse-desktop dev\"",
    "build:server:dev": "node scripts/build-server.mjs --dev",
    "build:server": "node scripts/build-server.mjs",
    "build:server:cross": "node scripts/build-server.mjs --cross",
    "build:web": "pnpm --filter kamehouse-web build",
    "build:desktop": "pnpm build:server && pnpm --filter kamehouse-desktop build",
    "build:desktop:dev": "pnpm build:server:dev && pnpm --filter kamehouse-desktop build",
    "build:all": "pnpm build:web && pnpm build:desktop",
    "codegen": "node scripts/run-codegen.mjs",
    "codegen:check": "node scripts/run-codegen.mjs && git diff --exit-code",
    "clean": "node -e \"const {rimrafSync}=require('rimraf');rimrafSync('node_modules');rimrafSync('apps/*/node_modules');\"",
    "clean:all": "node -e \"const {rimrafSync}=require('rimraf');rimrafSync('node_modules');rimrafSync('apps/*/node_modules');rimrafSync('apps/*/dist');rimrafSync('apps/*/out');rimrafSync('apps/desktop/src-tauri/target');rimrafSync('apps/desktop/src-tauri/binaries');rimrafSync('apps/server/kamehouse.exe');\""
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.13"
  },
  "patchedDependencies": {
    "jassub@2.5.1": "patches/jassub@2.5.1.patch"
  }
}