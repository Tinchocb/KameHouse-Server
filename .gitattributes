# Normalización global: LF por defecto, CRLF solo para batch
* text=auto eol=lf

# Archivos batch: CRLF obligatorio en Windows
*.bat text eol=crlf
*.cmd text eol=crlf

# Go: LF estricto (gofmt)
*.go text eol=lf

# Binarios/artefactos: nunca tocar
*.exe binary
*.wgt binary
*.zip binary
*.sqlite binary
*.db binary
*.dll binary
*.so binary
*.dylib binary

# Documentación: LF
*.md text eol=lf
*.txt text eol=lf