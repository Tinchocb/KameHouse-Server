# KameHouse Web - Variables de entorno
# Copia a .env.web y ajusta según tu entorno.

# Plataforma de ejecución: "desktop" o "web"
SEA_PUBLIC_PLATFORM="web"

# Puerto del backend Go para el proxy Rsbuild en desarrollo.
# El sidecar de Tauri usa el puerto 43212 en desarrollo.
KAMEHOUSE_DEV_API_PORT=43212

# El servidor de desarrollo escucha solo en 127.0.0.1. Su proxy de /api llega al backend
# como "localhost", así que abrirlo a la red saltaría las restricciones de escritura y de
# endpoints sensibles del servidor. Para probar desde el celular o la TV, y solo en una red
# de confianza:
# KAMEHOUSE_DEV_LAN=1
