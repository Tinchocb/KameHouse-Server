{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KameHouse",
  "version": "0.1.0",
  "identifier": "com.kamehouse.desktop",
  "build": {
    "frontendDist": "../../web/out",
    "devUrl": "http://127.0.0.1:43210",
    "beforeBuildCommand": "pnpm --filter kamehouse-web build"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://127.0.0.1:* http://localhost:* https:; font-src 'self' data: https:; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* ws://localhost:* https: wss:; media-src 'self' data: blob: http://127.0.0.1:* http://localhost:* https:; worker-src 'self' blob:; frame-src 'none';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Entertainment",
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/128x128.png",
      "icons/32x32.png"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": {
        "language": "en-US",
        "template": null
      }
    },
    "macOS": {
      "hardenedRuntime": true,
      "signingIdentity": "-"
    },
    "externalBin": [
      "binaries/kamehouse-server"
    ]
  },
  "plugins": {
    "shell": {
      "open": false
    },
    "updater": {
      "endpoints": [
        "https://kamehouse.app/api/updates/stable/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmtleSByZXF1aXJlZCBmb3IgdXBkYXRlciB0byB3b3JrCg==",
      "asyncDownload": true,
      "downloadInBackground": true,
      "dialog": true
    }
  }
}
